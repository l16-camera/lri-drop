{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LRI Drop",
  "version": "2026.7.14",
  "identifier": "dev.blmk.lri-drop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LRI Drop — Light Raw → DNG",
        "width": 720,
        "height": 820,
        "minWidth": 520,
        "minHeight": 640,
        "resizable": true,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
